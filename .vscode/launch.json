{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (Windows/MSYS2)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/dbg-windows/platformer.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "build debug (Windows)"
    },
    {
      "name": "Debug (Linux/GCC)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/dbg-linux/platformer",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build debug (Linux)"
    }
  ]
}
