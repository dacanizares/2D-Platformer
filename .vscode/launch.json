{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: run/dev.sh",
      "type": "node-terminal",
      "request": "launch",
      "command": "${workspaceFolder}/run/dev.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/dacanizares/source/2D-Platformer/src",
      "program": "/home/dacanizares/source/2D-Platformer/src/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
